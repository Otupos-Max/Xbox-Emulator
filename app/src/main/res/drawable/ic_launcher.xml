    <path android:fillColor="#22C55E" android:pathData="M53,44 h2 v2 h-2 z"/>
    <path android:fillColor="#22C55E" android:pathData="M53,62 h2 v2 h-2 z"/>
    <path android:fillColor="#22C55E" android:pathData="M44,53 h2 v2 h-2 z"/>
    <path android:fillColor="#22C55E" android:pathData="M62,53 h2 v2 h-2 z"/>

    <!-- Núcleo luminoso -->
    <path
