        android:strokeLineCap="round"
        android:pathData="M30,30 L78,78">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="30" android:startY="30"
                android:endX="78"   android:endY="78"
                android:startColor="#4ADE80"
                android:endColor="#0E7A3B"/>
        </aapt:attr>
    </path>

    <!-- Barra 2 do X (topo-direito → base-esquerda) -->
    <path
        android:strokeWidth="10"
        android:strokeLineCap="round"
        android:pathData="M78,30 L30,78">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="78" android:startY="30"
                android:endX="30"   android:endY="78"
                android:startColor="#4ADE80"
                android:endColor="#0E7A3B"/>
        </aapt:attr>
    </path>

    <!-- Disco escuro que isola o chip do X -->
    <path
        android:fillColor="#0B1210"
        android:pathData="M54,54m-11,0a11,11 0,1 1,22 0a11,11 0,1 1,-22 0"/>

    <!-- Anel do chip -->
